# Server-side Gemini API key (configured in Settings > Secrets)
GEMINI_API_KEY=

# ==============================================================================
# Direct WhatsApp / SMS / Email Verification Providers (add any ONE you prefer)
# Configure these in AI Studio: Settings (gear icon) > Secrets
# ==============================================================================

# Option 1: Meta WhatsApp Business Cloud API (Direct)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_API_VERSION=v21.0

# Option 2: Twilio Direct (WhatsApp and/or SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Option 3: Clickatell South Africa Direct SMS
CLICKATELL_API_KEY=
CLICKATELL_FROM=

# Option 4: Resend Direct Transactional Email (Admin review alerts & owner notices)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_ALERT_EMAIL=

# Optional: Custom HTTPS webhook fallback (only if using Make/Zapier/n8n)
WHATSAPP_OTP_WEBHOOK_URL=
SMS_OTP_WEBHOOK_URL=
EMAIL_OTP_WEBHOOK_URL=
OTP_WEBHOOK_AUTH_TOKEN=
